# Copy this to a private env file and pass it to deploy_apple_container.sh with ENV_FILE=...
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
ANOMALOHARIS_SEARCH_MODE=diy
WEB_RESEARCH_SUBAGENT_MODEL=deepseek/deepseek-v4-flash-0731
SEARCH_MODE_TIMEOUT_SECONDS=90
ANOMALOHARIS_ENV=production
HOST=0.0.0.0
ANOMALOHARIS_ACKNOWLEDGE_PUBLIC_HOST=true
# Required whenever HOST is not loopback. Generate a long random secret.
ANOMALOHARIS_SERVICE_TOKEN=
ANOMALOHARIS_SERVICE_AUTH_REQUIRED=true
# The deployment script mounts REMOTE_DATA_DIR here for persistent SQLite sessions/checkpoints.
ANOMALOHARIS_DATA_DIR=/data
# Required for public management routes; use a different random secret.
ANOMALOHARIS_ADMIN_TOKEN=
ANOMALOHARIS_AGENT_PROMPT_PROFILE=agent
ANOMALOHARIS_DEFAULT_PRESET_MODEL=anomaloharis@1
ANOMALOHARIS_WORKFLOW_DB_PATH=/data/workflows.sqlite3
ANOMALOHARIS_WORKFLOW_ALLOWED_REFS=
ANOMALOHARIS_RUN_MAX_CONCURRENCY=8
ANOMALOHARIS_PI_EXTENSIONS_ENABLED=false
ANOMALOHARIS_PLUGIN_CONFIG=./runtime-bundle/config/plugins.yaml
ANOMALOHARIS_PLUGIN_TIMEOUT_MS=30000
# Apple Container currently does not provide container-name DNS. Use the
# gateway address of anomaloharis-external for the published Buddy port.
ANOMALOHARIS_BUDDY_SERVICE_URL=http://192.168.67.1:8765
# Forwarded to the admin-only Buddy dashboard proxy and allowlisted child plugin.
ANOMALOHARIS_BUDDY_SERVICE_TOKEN=
ANOMALOHARIS_BUDDY_REQUEST_TIMEOUT_MS=1500
WEB_TOOLS_ENABLED=true
WEB_FETCH_TIMEOUT_SECONDS=30
WEB_FETCH_MAX_CHARS=30000
# FruitSpy is an external service. Use a host-reachable address from the
# container; configure this independently of the Buddy service network.
PYTHON_SANDBOX_ENABLED=true
PYTHON_SANDBOX_TIMEOUT_SECONDS=10
FRUITSPY_PYTHON_TOOL_BASE_URL=http://host.docker.internal:8848
FRUITSPY_PYTHON_TOOL_API_PATH=/api/v1/tools/python
FRUITSPY_PYTHON_TOOL_TOKEN=
FRUITSPY_PYTHON_TOOL_STATUS_TIMEOUT_SECONDS=2
# Stable secret for signed browser-readable artifact URLs; falls back to ANOMALOHARIS_ADMIN_TOKEN.
ANOMALOHARIS_ARTIFACT_SECRET=
# Buddy, audio, and vision are intentionally absent from the production image.
# If a capability returns, install and allowlist its independent Node plugin or
# configure an external service; do not add its runtime to this env file.
