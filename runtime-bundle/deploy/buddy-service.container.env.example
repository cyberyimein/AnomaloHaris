# Copy this to runtime-bundle/deploy/buddy-service.container.env and pass it
# to deploy_buddy_container.sh with ENV_FILE=.... The private env file is ignored.
# The service shares the anomaloharis-external network with Anomalo.
BUDDY_HOST=0.0.0.0
BUDDY_PORT=8765
# Generate two different long random values for these tokens.
BUDDY_SERVICE_TOKEN=
BUDDY_HOOK_TOKEN=
BUDDY_APPROVAL_ENABLED=false
BUDDY_APPROVAL_TIMEOUT_SECONDS=30
BUDDY_AUTO_CONNECT=true

# Device transport. The deployment script publishes host TCP 8787 to this port.
BUDDY_TRANSPORT=tcp
BUDDY_SERIAL_PORT=
BUDDY_BAUD_RATE=115200
BUDDY_TCP_HOST=0.0.0.0
BUDDY_TCP_PORT=8787
# Apple Container NATs published TCP clients through the network gateway.
# For the current anomaloharis-external network this is 192.168.67.1.
BUDDY_TCP_CLIENT_IP=192.168.67.1
BUDDY_HOST_NAME=MacMiniM4
BUDDY_EVENT_BUFFER_SIZE=200
