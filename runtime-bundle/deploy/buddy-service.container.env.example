# Copy to runtime-bundle/deploy/buddy-service.container.env and set unique tokens.
BUDDY_HOST=0.0.0.0
BUDDY_PORT=8765
BUDDY_SERVICE_TOKEN=
BUDDY_ADMIN_TOKEN=

# Set the StackChan's fixed Wi-Fi address and its separate device token.
BUDDY_DEVICE_URL=
BUDDY_DEVICE_TOKEN=

BUDDY_POLL_INTERVAL_MS=2000
BUDDY_FRESHNESS_MS=8000
BUDDY_REQUEST_TIMEOUT_MS=4000
BUDDY_INVOKE_TIMEOUT_MS=30000
BUDDY_PERMISSIONS_FILE=/data/buddy/permissions.json
