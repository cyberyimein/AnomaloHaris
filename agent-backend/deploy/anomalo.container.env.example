# Copy this to a private env file and pass it to deploy_apple_container.sh with ENV_FILE=...
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_API_KEY=
OPENROUTER_CREDITS_CACHE_SECONDS=82800
OPENROUTER_CREDITS_TIMEOUT_SECONDS=8
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
ANOMALO_SEARCH_MODE=diy
WEB_RESEARCH_SUBAGENT_MODEL=deepseek/deepseek-v4-flash-0731
SEARCH_MODE_TIMEOUT_SECONDS=90
ANOMALO_APP_TITLE=Anomalo
ANOMALO_ENV=production
ANOMALO_SITE_URL=http://localhost:8000
# The deployment script mounts REMOTE_DATA_DIR here for persistent SQLite sessions/checkpoints.
ANOMALO_DATA_DIR=/data
ANOMALO_ADMIN_TOKEN=
ANOMALO_AGENT_PROMPT_PROFILE=agent
ANOMALO_BUDDY_PROMPT_PROFILE=buddy_voice
MCP_TIMEOUT_SECONDS=8
PYTHON_SANDBOX_ENABLED=true
FRUITSPY_PYTHON_TOOL_BASE_URL=http://127.0.0.1:8848
FRUITSPY_PYTHON_TOOL_TOKEN=
FRUITSPY_PYTHON_TOOL_STATUS_TIMEOUT_SECONDS=2
WEB_TOOLS_ENABLED=true
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_CACHE_SECONDS=300
WEB_FETCH_PROVIDER=auto
WEB_FETCH_TIMEOUT_SECONDS=30
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MAX_CHARS=30000
# Leave empty to reuse FRUITSPY_PYTHON_TOOL_BASE_URL and its token.
FRUITSPY_CRAWL_API_BASE_URL=
FRUITSPY_CRAWL_API_PATH=/api/v1/tools/crawl
# Leave empty to reuse FRUITSPY_PYTHON_TOOL_TOKEN.
FRUITSPY_CRAWL_API_TOKEN=

# Production images include Buddy control. They do not install STT/TTS model dependencies unless
# the image is built with INSTALL_EXTRAS=audio,buddy.
# One-time host setup (repeat after a host restart if the packet-filter rule is removed):
# sudo container system dns create host.container.internal --localhost 203.0.113.113
#
# The Python sandbox tool is hosted by FruitSpy on the same Mac. Configure the shared token in
# a private env file; do not commit it. If container loopback cannot reach FruitSpy, set the
# base URL to the host-reachable FruitSpy address and make sure FruitSpy permits that source.

# TCP is the deploy-friendly Buddy mode; serial devices need explicit passthrough support.
ANOMALO_BUDDY_TRANSPORT=tcp
ANOMALO_BUDDY_TCP_HOST=0.0.0.0
ANOMALO_BUDDY_TCP_PORT=8787
ANOMALO_BUDDY_TCP_CLIENT_IP=
ANOMALO_BUDDY_EVENT_BUFFER_SIZE=200
ANOMALO_BUDDY_AUDIO_AI_ENABLED=false
ANOMALO_BUDDY_AUDIO_DEBUG_STORAGE=off

# Optional low-frequency server-side face detection. The detector is loaded on first image request.
ANOMALO_BUDDY_VISION_ENABLED=false
ANOMALO_BUDDY_VISION_PROVIDER=opencv_haar
ANOMALO_BUDDY_VISION_MODEL_SELECTION=1
ANOMALO_BUDDY_VISION_SCORE_THRESHOLD=0.45
ANOMALO_BUDDY_VISION_PAUSE_MS=300000
ANOMALO_BUDDY_VISION_LOOK_ENABLED=true
ANOMALO_BUDDY_VISION_LOOK_MAX_YAW_DEGREES=25
ANOMALO_BUDDY_VISION_LOOK_MAX_PITCH_DEGREES=12
ANOMALO_BUDDY_VISION_LOOK_CENTER_YAW=0
ANOMALO_BUDDY_VISION_LOOK_CENTER_PITCH=260
ANOMALO_BUDDY_VISION_LOOK_SPEED=40
ANOMALO_BUDDY_VISION_LOOK_DEADBAND=0.12
ANOMALO_BUDDY_VISION_LOOK_INVERT_X=false
ANOMALO_BUDDY_VISION_LOOK_INVERT_Y=false
ANOMALO_BUDDY_VISION_FRAME_TOKEN=
ANOMALO_BUDDY_VISION_FRAME_CLIENT_IP=
ANOMALO_BUDDY_VISION_MAX_UPLOAD_BYTES=2000000
ANOMALO_BUDDY_VISION_MAX_IMAGE_DIMENSION=640
