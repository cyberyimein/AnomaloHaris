# Copy this to a private env file and pass it to deploy_apple_container.sh with ENV_FILE=...
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
ANOMALO_SEARCH_MODE=diy
ANOMALO_ENV=production
HOST=0.0.0.0
ANOMALO_ACKNOWLEDGE_PUBLIC_HOST=true
# Required whenever HOST is not loopback. Generate a long random secret.
ANOMALO_SERVICE_TOKEN=
ANOMALO_SERVICE_AUTH_REQUIRED=true
# The deployment script mounts REMOTE_DATA_DIR here for persistent SQLite sessions/checkpoints.
ANOMALO_DATA_DIR=/data
# Required for public management routes; use a different random secret.
ANOMALO_ADMIN_TOKEN=
ANOMALO_AGENT_PROMPT_PROFILE=agent
ANOMALO_DEFAULT_PRESET_MODEL=anomalo@1
ANOMALO_PI_EXTENSIONS_ENABLED=false
ANOMALO_PLUGIN_CONFIG=./agent-backend/config/plugins.yaml
ANOMALO_PLUGIN_TIMEOUT_MS=30000
WEB_TOOLS_ENABLED=true
WEB_FETCH_TIMEOUT_SECONDS=30
WEB_FETCH_MAX_CHARS=30000
# Buddy, audio, and vision are intentionally absent from the production image.
# If a capability returns, install and allowlist its independent Node plugin or
# configure an external service; do not add its runtime to this env file.
