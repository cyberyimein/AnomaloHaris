{
  "additionalProperties": true,
  "$id": "https://anomalo.dev/schemas/agent-event.schema.json",
  "type": "object",
  "required": [
    "type",
    "session_id",
    "run_id",
    "data",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "number"
    },
    "type": {
      "anyOf": [
        {
          "const": "run.started",
          "type": "string"
        },
        {
          "const": "llm.request",
          "type": "string"
        },
        {
          "const": "message.delta",
          "type": "string"
        },
        {
          "const": "message.done",
          "type": "string"
        },
        {
          "const": "tool.started",
          "type": "string"
        },
        {
          "const": "tool.finished",
          "type": "string"
        },
        {
          "const": "tool.error",
          "type": "string"
        },
        {
          "const": "run.finished",
          "type": "string"
        },
        {
          "const": "run.stopped",
          "type": "string"
        },
        {
          "const": "run.error",
          "type": "string"
        }
      ]
    },
    "session_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "data": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    },
    "timestamp": {
      "minLength": 1,
      "type": "string"
    }
  }
}
