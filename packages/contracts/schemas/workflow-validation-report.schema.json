                "type": "string"
              },
              {
                "const": "WORKFLOW_MANIFEST_OUTDATED",
                "type": "string"
              }
            ]
          },
          "path": {
            "pattern": "^(?:|(?:/[^~]*(?:~[01][^~]*)*)*)$",
