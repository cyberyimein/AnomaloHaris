{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "ref",
    "name",
    "version",
    "description",
    "status",
    "definition_hash",
    "compiled_hash",
    "capability_manifest_hash",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "ref": {
      "pattern": "^[a-z][a-z0-9-]{0,63}@[1-9][0-9]{0,8}$",
      "minLength": 3,
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "description": {
      "maxLength": 4000,
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "draft",
          "type": "string"
        },
        {
          "const": "published",
          "type": "string"
        },
        {
          "const": "retired",
          "type": "string"
        }
      ]
    },
    "definition_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "compiled_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "capability_manifest_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "created_at": {
      "minLength": 1,
      "type": "string"
    },
    "updated_at": {
      "minLength": 1,
      "type": "string"
    },
    "published_at": {
      "minLength": 1,
      "type": "string"
    },
    "retired_at": {
      "minLength": 1,
      "type": "string"
    }
  }
}
