{
  "type": "object",
  "required": [
    "object",
    "data"
  ],
  "properties": {
    "object": {
      "const": "list",
      "type": "string"
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "object",
          "created",
          "owned_by"
        ],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9._-]{0,63}@[1-9][0-9]{0,8}$",
            "minLength": 3,
            "type": "string"
          },
          "object": {
            "const": "model",
            "type": "string"
          },
          "created": {
            "minimum": 0,
            "type": "integer"
          },
          "owned_by": {
            "minLength": 1,
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {}
            }
          }
        }
      }
    }
  }
}
