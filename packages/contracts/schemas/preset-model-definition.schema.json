{
  "additionalProperties": true,
  "$id": "https://anomaloharis.dev/schemas/preset-model-definition.schema.json",
  "type": "object",
  "required": [
    "name",
    "version",
    "description",
    "provider"
  ],
  "properties": {
    "name": {
      "pattern": "^[a-z][a-z0-9._-]{0,63}$",
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "provider": {
      "type": "object",
      "required": [
        "adapter",
        "model"
      ],
      "properties": {
        "adapter": {
          "minLength": 1,
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "credential_ref": {
          "minLength": 1,
          "type": "string"
        },
        "tool_protocol": {
          "anyOf": [
            {
              "const": "openai",
              "type": "string"
            },
            {
              "const": "dsml",
              "type": "string"
            },
            {
              "const": "auto",
              "type": "string"
            },
            {
              "const": "none",
              "type": "string"
            }
          ]
        },
        "capabilities": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {}
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "properties": {
        "profile": {
          "minLength": 1,
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "skills": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "maxLength": 262144,
                "type": "string"
              }
            }
          }
        },
        "skill_files": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "minLength": 1,
                "maxLength": 256,
                "type": "string"
              },
              "content": {
                "maxLength": 262144,
                "type": "string"
              }
            }
          }
        },
        "skill_markdown": {
          "maxLength": 262144,
          "type": "string"
        }
      }
    },
    "plugins": {
      "type": "object",
      "required": [
        "fixed"
      ],
      "properties": {
        "fixed": {
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "minLength": 1,
            "type": "string"
          }
        },
        "bootstrap_tools": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {}
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    },
    "metadata": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    }
  }
}
