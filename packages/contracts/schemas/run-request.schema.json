{
  "additionalProperties": true,
  "$id": "https://anomalo.dev/schemas/run-request.schema.json",
  "type": "object",
  "required": [
    "message"
  ],
  "properties": {
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resume": {
      "type": "boolean"
    },
    "prompt_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "search_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "preset_model": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9._-]{0,63}@[1-9][0-9]{0,8}$",
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "response_format": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "text",
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "json_object",
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "json_schema"
              ],
              "properties": {
                "type": {
                  "const": "json_schema",
                  "type": "string"
                },
                "json_schema": {
                  "type": "object",
                  "required": [
                    "name",
                    "schema"
                  ],
                  "properties": {
                    "name": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "strict": {
                      "type": "boolean"
                    },
                    "schema": {
                      "type": "object",
                      "patternProperties": {
                        "^(.*)$": {}
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
