{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anomalo.dev/schemas/run-request.schema.json",
  "title": "Anomalo Run Request",
  "type": "object",
  "required": ["message"],
  "properties": {
    "message": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "resume": { "type": "boolean" },
    "prompt_profile": { "type": ["string", "null"] },
    "search_mode": { "type": ["string", "null"] },
    "response_format": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
