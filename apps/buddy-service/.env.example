# Independent Node Buddy service. Keep this environment separate from the Agent Host.
BUDDY_HOST=127.0.0.1
BUDDY_PORT=8765
BUDDY_SERVICE_TOKEN=
BUDDY_HOOK_TOKEN=
BUDDY_APPROVAL_ENABLED=false
BUDDY_APPROVAL_TIMEOUT_SECONDS=30
BUDDY_AUTO_CONNECT=true

# `tcp` is the dependency-free local default. Use `serial` with the optional
# serialport package and a BUDDY_SERIAL_PORT such as /dev/tty.usbmodem2101.
BUDDY_TRANSPORT=auto
BUDDY_SERIAL_PORT=
BUDDY_BAUD_RATE=115200
# Keep the listener local unless a fixed Buddy client IP is configured below.
BUDDY_TCP_HOST=127.0.0.1
BUDDY_TCP_PORT=8766
BUDDY_TCP_CLIENT_IP=
BUDDY_HOST_NAME=
BUDDY_EVENT_BUFFER_SIZE=256
