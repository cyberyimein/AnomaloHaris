# HTTP API used by the AnomaloHaris host, CLI, and optional agent plugin.
BUDDY_HOST=127.0.0.1
BUDDY_PORT=8765
BUDDY_SERVICE_TOKEN=
BUDDY_ADMIN_TOKEN=

# Fixed Wi-Fi address and authentication token for StackChan.
BUDDY_DEVICE_URL=
BUDDY_DEVICE_TOKEN=

# Device status is polled automatically. State is stale after four missed polls.
BUDDY_POLL_INTERVAL_MS=2000
BUDDY_FRESHNESS_MS=8000
BUDDY_REQUEST_TIMEOUT_MS=4000
BUDDY_INVOKE_TIMEOUT_MS=30000
BUDDY_PERMISSIONS_FILE=./data/buddy/permissions.json
