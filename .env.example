OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
ANOMALO_DEFAULT_PRESET_MODEL=anomalo@1
ANOMALO_PRESET_MODEL_DB_PATH=
ANOMALO_SEARCH_MODE=diy
WEB_RESEARCH_SUBAGENT_MODEL=deepseek/deepseek-v4-flash-0731
SEARCH_MODE_TIMEOUT_SECONDS=90
BROWSER_TOOL_TIMEOUT_SECONDS=60
ANOMALO_ENV=development
ANOMALO_ACKNOWLEDGE_PUBLIC_HOST=false
ANOMALO_PI_EXTENSIONS_ENABLED=false
ANOMALO_PLUGIN_CONFIG=./runtime-bundle/config/plugins.yaml
ANOMALO_COMPUTE_DB_PATH=./data/compute.sqlite3
# JSON array: [{"id":"luna-service","token":"replace-me","scopes":["compute:models","compute:invoke","compute:read"]}]
ANOMALO_SERVICE_TOKENS=
ANOMALO_SERVICE_TOKEN=
ANOMALO_SERVICE_AUTH_REQUIRED=false
ANOMALO_PLUGIN_TIMEOUT_MS=30000
ANOMALO_BUDDY_SERVICE_URL=http://127.0.0.1:8765
ANOMALO_BUDDY_SERVICE_TOKEN=
ANOMALO_BUDDY_REQUEST_TIMEOUT_MS=1500
# Optional independent Node Buddy service (run apps/buddy-service separately).
BUDDY_HOST=127.0.0.1
BUDDY_PORT=8765
BUDDY_HOOK_BASE_URL=http://127.0.0.1:8765
BUDDY_SERVICE_TOKEN=
BUDDY_HOOK_TOKEN=
BUDDY_AUTO_CONNECT=true
BUDDY_TRANSPORT=auto
BUDDY_SERIAL_PORT=
BUDDY_BAUD_RATE=115200
BUDDY_TCP_HOST=127.0.0.1
BUDDY_TCP_PORT=8766
BUDDY_TCP_CLIENT_IP=
# SQLite session/checkpoint storage. In production, point this at the mounted /data directory.
ANOMALO_DATA_DIR=./data
ANOMALO_ADMIN_TOKEN=
ANOMALO_AGENT_PROMPT_PROFILE=agent
WEB_TOOLS_ENABLED=true
WEB_FETCH_TIMEOUT_SECONDS=30
WEB_FETCH_MAX_CHARS=30000
PYTHON_SANDBOX_ENABLED=true
PYTHON_SANDBOX_TIMEOUT_SECONDS=10
# FruitSpy runs outside the AnomaloHaris process/container.
FRUITSPY_PYTHON_TOOL_BASE_URL=
FRUITSPY_PYTHON_TOOL_API_PATH=/api/v1/tools/python
FRUITSPY_PYTHON_TOOL_TOKEN=
FRUITSPY_PYTHON_TOOL_STATUS_TIMEOUT_SECONDS=2
# Stable secret used to sign browser-readable artifact capability URLs.
ANOMALO_ARTIFACT_SECRET=
