OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
ANOMALO_DEFAULT_PRESET_MODEL=anomalo@1
ANOMALO_PRESET_MODEL_DB_PATH=
ANOMALO_SEARCH_MODE=diy
BROWSER_TOOL_TIMEOUT_SECONDS=60
ANOMALO_ENV=development
ANOMALO_ACKNOWLEDGE_PUBLIC_HOST=false
ANOMALO_PI_EXTENSIONS_ENABLED=false
ANOMALO_PLUGIN_CONFIG=./agent-backend/config/plugins.yaml
ANOMALO_COMPUTE_DB_PATH=./data/compute.sqlite3
# JSON array: [{"id":"luna-service","token":"replace-me","scopes":["compute:models","compute:invoke","compute:read"]}]
ANOMALO_SERVICE_TOKENS=
ANOMALO_SERVICE_TOKEN=
ANOMALO_SERVICE_AUTH_REQUIRED=false
ANOMALO_PLUGIN_TIMEOUT_MS=30000
# SQLite session/checkpoint storage. In production, point this at the mounted /data directory.
ANOMALO_DATA_DIR=./data
ANOMALO_ADMIN_TOKEN=
ANOMALO_AGENT_PROMPT_PROFILE=agent
WEB_TOOLS_ENABLED=true
WEB_FETCH_TIMEOUT_SECONDS=30
WEB_FETCH_MAX_CHARS=30000
